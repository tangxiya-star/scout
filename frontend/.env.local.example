# Hexclave (frontend SDK) — get these from https://app.hexclave.com
# Copy this file to .env.local and fill in your project's values.
#
# Public API base URL (safe to expose to the client):
NEXT_PUBLIC_HEXCLAVE_API_URL=
# Public project id (safe to expose to the client):
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=
# Server-only secret — never commit this or expose it to the client:
HEXCLAVE_SECRET_SERVER_KEY=
